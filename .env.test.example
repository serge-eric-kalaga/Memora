# Exemple versionné : copier vers .env.test à la racine.
# Remplacer les valeurs CHANGE_ME avant utilisation ; ne pas versionner le fichier réel.

APP_NAME="Fullstack Template Tests"
ADMINS_EMAIL="tests@example.com"
SECRET_KEY="CHANGE_ME_APP_SECRET"
JWT_SECRET="CHANGE_ME_JWT_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="15"
DATABASE_URL="sqlite:///.test.db"
RATE_LIMIT_ENABLED="false"
CACHE_ENABLED="false"
REDIS_URL=""
REDIS_DATABASE_URL=""
REDIS_PREFIX="fullstack-template:test:v1"
CELERY_BROKER_URL="memory://"
CELERY_RESULT_BACKEND="cache+memory://"
EMAIL_VERIFICATION_ENABLED="false"
EMAIL_HOST="127.0.0.1"
EMAIL_PORT="9"
EMAIL_DOMAIN="example.com"
EMAIL_USERNAME="tests"
EMAIL_PASSWORD="tests-only-not-a-real-password"
