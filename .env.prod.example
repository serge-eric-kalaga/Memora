# Exemple versionné : copier vers .env.prod à la racine.
# Remplacer les valeurs CHANGE_ME avant utilisation ; ne pas versionner le fichier réel.
# Les initialiseurs scripts/init_project.py et scripts/init_production.py génèrent les secrets.
# MYSQL_PASSWORD et RABBITMQ_DEFAULT_PASS doivent aussi correspondre aux URL associées.

COMPOSE_PROJECT_NAME="fullstack-template-prod"
APP_NAME="Fullstack Template"
NEXT_PUBLIC_APP_NAME="Fullstack Template"
ADMINS_EMAIL="admin@example.com"
SECRET_KEY="CHANGE_ME_APP_SECRET"
JWT_SECRET="CHANGE_ME_JWT_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"
MYSQL_ROOT_PASSWORD="CHANGE_ME_MYSQL_ROOT_PASSWORD"
MYSQL_DATABASE="fullstack_template"
MYSQL_USER="application"
MYSQL_PASSWORD="CHANGE_ME_MYSQL_PASSWORD"
DATABASE_URL="mysql+pymysql://application:CHANGE_ME_MYSQL_PASSWORD@mysql:3306/fullstack_template"
REDIS_URL="redis://redis:6379/0"
REDIS_PREFIX="fullstack-template:prod:v1"
# Rate limiting partagé dans Redis. 0 désactive uniquement le quota global.
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_GLOBAL_LIMIT="300"
RATE_LIMIT_GLOBAL_WINDOW_SECONDS="60"
RATE_LIMIT_FAIL_CLOSED="true"
CACHE_ENABLED="true"
CACHE_TTL_SECONDS="60"
CELERY_BROKER_URL="amqp://worker:CHANGE_ME_RABBITMQ_PASSWORD@task-broker:5672//"
CELERY_RESULT_BACKEND="redis://redis:6379/1"
RABBITMQ_DEFAULT_USER="worker"
RABBITMQ_DEFAULT_PASS="CHANGE_ME_RABBITMQ_PASSWORD"
FRONTEND_URL="https://app.example.com"
APP_ORIGIN="https://app.example.com"
# Stockage privé : local par défaut ; renseigner S3_* pour activer s3.
STORAGE_BACKEND="local"
S3_BUCKET=""
S3_ENDPOINT_URL=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ADDRESSING_STYLE="auto"
PROFILE_PHOTO_DIR="static/uploads/profile_photos"
PROFILE_PHOTO_MAX_BYTES="5242880"
PROFILE_PHOTO_MAX_PIXELS="16000000"
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_DOMAIN="example.com"
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
EMAIL_VERIFICATION_ENABLED="false"
EMAIL_VERIFICATION_EXPIRE_MINUTES="60"
EMAIL_VERIFICATION_WINDOW_SECONDS="900"
EMAIL_VERIFICATION_EMAIL_LIMIT="3"
EMAIL_VERIFICATION_IP_LIMIT="30"
PASSWORD_RESET_EXPIRE_MINUTES="30"
PASSWORD_RESET_WINDOW_SECONDS="900"
PASSWORD_RESET_EMAIL_LIMIT="3"
PASSWORD_RESET_IP_LIMIT="30"
DOMAIN="app.example.com"
TLS_EMAIL="admin@example.com"
INITIALISE_DATABASE="false"
SESSION_COOKIE_SECURE="true"
