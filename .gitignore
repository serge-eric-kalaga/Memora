.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage*
coverage.xml

# Next.js / Node.js
node_modules/
.next/
out/
coverage/
.npm/
*.tsbuildinfo
next-env.d.ts
.vercel/

