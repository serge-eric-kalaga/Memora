# Documentation of the local environment generated into .memora/backend.env.
APP_NAME=Memora
FRONTEND_URL=http://localhost:3000
MEMORA_DATA_DIR=/absolute/path/to/Memora/.memora/data
MEMORA_MODEL_DIR=/absolute/path/to/Memora/.memora/models
MEMORA_OLLAMA_URL=http://127.0.0.1:11434
MEMORA_MODEL=gemma4:e4b
MEMORA_ASR_MODEL=base
# Validated default on native Apple Silicon; CPU alternative is faster-whisper.
MEMORA_ASR_ENGINE=mlx-whisper
MEMORA_LIVE_ASR_ENGINE=mlx-whisper
MEMORA_MLX_MODEL_PATH=/absolute/path/to/Memora/.memora/models/mlx-large-v3-turbo
# Experimental full large-v3 route for final explicitly French audio only (~3.08GB).
# NOT the recommended default: clean-speech gains but noise/bilingual regressions measured.
# Leave unset to preserve the configured primary model. Installer only prepares it when nonempty.
# MEMORA_MLX_FR_MODEL_PATH=/absolute/path/to/Memora/.memora/models/mlx-large-v3
MEMORA_SMTP_HOST=127.0.0.1
MEMORA_SMTP_PORT=1025
# Frontend server environment; chat only, bounded 1000..1800000 ms.
MEMORA_CHAT_TIMEOUT_MS=600000
# Database and cryptographic keys are generated by scripts/memora-env.py.
# Never use placeholders or commit the generated .memora/backend.env.
# Docker alternative: Ollama host URL is http://host.docker.internal:11434,
# not container localhost. Keep Ollama bound to the host, never expose publicly.

# Explicit French uses language-conditioned Whisper transcription on native Apple Silicon.
# English, bilingual/auto and live audio keep Turbo. Existing generated files are never changed.
# On Linux/other platforms: MEMORA_ASR_ENGINE=faster-whisper, MEMORA_LIVE_ASR_ENGINE=faster-whisper,
# and leave both optional French keys empty. Empty French engine retains the configured primary engine.
MEMORA_FRENCH_ASR_ENGINE=mlx-whisper
# Optional Parakeet is multilingual with automatic language selection; it cannot force French.
# MEMORA_PARAKEET_MODEL_PATH=/absolute/path/to/Memora/.memora/models/parakeet-v3

# Optional local voice separation (validated on native macOS Apple Silicon).
# Preparation is offline from the pinned Resemblyzer package; no voice identities.
# Default is .memora/models/resemblyzer-0.1.4 beneath this project.
# MEMORA_DIARIZATION_MODEL_DIR=/absolute/path/to/Memora/.memora/models/resemblyzer-0.1.4
# CPU threads for local voice separation (1..8, default 2; restored after each job).
# MEMORA_DIARIZATION_CPU_THREADS=2
