# Exemple versionné : copier vers .env.grafana.prod à la racine.
# Remplacer les valeurs CHANGE_ME avant utilisation ; ne pas versionner le fichier réel.
# Alternative recommandée : python3 scripts/init_monitoring.py --production

GF_SECURITY_ADMIN_USER="admin"
GF_SECURITY_ADMIN_PASSWORD="CHANGE_ME_GRAFANA_PASSWORD"
MYSQL_MONITORING_PASSWORD="CHANGE_ME_MONITORING_PASSWORD"
MONITORING_ENV="prod"
BACKEND_LOG_SOURCE="backend_logs"
ALERTMANAGER_WEBHOOK_URL=""
